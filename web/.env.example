AGENT_URL=http://localhost:8000
# Optional shared secret for the Python AG-UI endpoint. Use the exact same value
# in the repository-root .env when deploying the Python agent separately.
AGENT_AUTH_HEADER=
COPILOTKIT_TELEMETRY_DISABLED=true

# Required only by `npm run channels`. Keep these server-side; never prefix them
# with NEXT_PUBLIC_ and never commit the values.
INTELLIGENCE_API_KEY=
CHANNEL_CODE=workspace-council
CHANNEL_PORT=3001

# Optional comma-separated Slack member IDs allowed to approve a proposed write
# in addition to the person who started the Slack conversation.
SLACK_APPROVER_IDS=
